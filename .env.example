# Admin Authentication
ADMIN_PASSWORD="admin_change_this_password"

# Cloudinary Media Storage (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"
